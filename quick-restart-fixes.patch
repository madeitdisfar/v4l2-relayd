@@ -273,20 +283,90 @@ splash_pipeline_get ()
   return splash_pipeline;
 }
 
+static gboolean input_pipeline_stall_check (gpointer user_data);
+
 static void
 input_pipeline_enable ()
 {
   gst_element_set_state (splash_pipeline_get (), GST_STATE_NULL);
   gst_element_set_state (input_pipeline_get (), GST_STATE_PLAYING);
+
+  if (opt_stall_timeout > 0 && stall_check_id == 0) {
+    input_frames_checked = g_atomic_int_get (&input_frames);
+    stall_checks_waited = 0;
+    stall_check_id = g_timeout_add (opt_stall_timeout,
+                                    input_pipeline_stall_check, NULL);
+  }
+}
+
+/* The input pipeline is freed and created again on the next enable: a
+ * reused pipewiresrc pipeline may run at a few frames per second after a
+ * quick restart. */
+static void
+input_pipeline_free ()
+{
+  gst_element_set_state (input_pipeline, GST_STATE_NULL);
+  g_source_remove (input_bus_watch_id);
+  input_bus_watch_id = 0;
+  gst_clear_object (&input_pipeline);
 }
 
 static void
 input_pipeline_disable ()
 {
-  if (input_pipeline != NULL)
-    gst_element_set_state (input_pipeline, GST_STATE_NULL);
-  if (input_pipeline != NULL)
+  if (stall_check_id > 0) {
+    g_source_remove (stall_check_id);
+    stall_check_id = 0;
+  }
+  if (stall_restart_id > 0) {
+    g_source_remove (stall_restart_id);
+    stall_restart_id = 0;
+  }
+  if (input_pipeline != NULL) {
+    input_pipeline_free ();
     gst_element_set_state (splash_pipeline, GST_STATE_PLAYING);
+  }
+}
+
+static gboolean
+input_pipeline_stall_restart (gpointer user_data G_GNUC_UNUSED)
+{
+  stall_restart_id = 0;
+  input_pipeline_enable ();
+
+  return G_SOURCE_REMOVE;
+}
+
+/* A PipeWire camera reopened while it is being suspended can keep sending
+ * only a few frames per second. Stopping it for a second (so it suspends)
+ * and starting again recovers; clients keep the last frame meanwhile. */
+static gboolean
+input_pipeline_stall_check (gpointer user_data G_GNUC_UNUSED)
+{
+  gint frames = g_atomic_int_get (&input_frames);
+  gint received = frames - input_frames_checked;
+
+  input_frames_checked = frames;
+
+  /* Measure from the first frame on: a camera's first start can take over a
+   * second. Restart when no frame comes at all within three checks. */
+  if (stall_checks_waited >= 0) {
+    if (received > 0) {
+      stall_checks_waited = -1;
+      return G_SOURCE_CONTINUE;
+    }
+    if (++stall_checks_waited < 3)
+      return G_SOURCE_CONTINUE;
+  } else if (received >= opt_stall_timeout / 100)
+    return G_SOURCE_CONTINUE;
+
+  g_warning ("Input below 10 fps (%d frames since the last check), restarting it",
+             received);
+  stall_check_id = 0;
+  input_pipeline_free ();
+  stall_restart_id = g_timeout_add (1000, input_pipeline_stall_restart, NULL);
+
+  return G_SOURCE_REMOVE;
 }
 
